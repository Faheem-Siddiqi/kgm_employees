# Copy this file to .env and replace every value with your local settings.

KGM_DB_HOST=127.0.0.1
KGM_DB_PORT=3306
KGM_DB_NAME=kgm_ex_employees_demo
KGM_DB_USER=demo_user
KGM_DB_PASSWORD=change_me_db_password

KGM_ADMIN_USER=admin
KGM_ADMIN_PASSWORD=change_me_admin_password

KGM_EMPLOYEE_STORAGE_DIR=resources/employees
# Maximum prepared JPG/JPEG document/photo upload size in bytes. Larger JPG/JPEG files use the best JPEG quality that fits this limit.
# Commas are accepted, for example 614,400.
KGM_DOCUMENT_UPLOAD_MAX_BYTES=409600
KGM_LONG_SERVICE_TIMEOUT_MINUTES=15
# Timeout in minutes for bulk document upload, Excel import, and Excel export services.
